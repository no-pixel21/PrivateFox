# -*- Mode: python -*-
# Private Fox: ship policies and the startup script.

# browser/moz.build exports DIST_SUBDIR = "browser", which would put these files into
# <app>/browser/. Firefox reads distribution/, defaults/pref/ and the autoconfig file from
# the application root (next to the executable; Contents/Resources on macOS), so install there.
FINAL_TARGET = "dist/bin"

FINAL_TARGET_FILES.distribution += [
    "policies-level0.json",
    "policies-level1.json",
    "policies-level2.json",
    "policies-level3.json",
    "policies-level4.json",
]

# The autoconfig prefs (general.config.*) are not shipped as a separate file; prepare_tree.py
# appends them to Firefox's own default prefs, which are always packaged.

FINAL_TARGET_FILES += [
    "privatefox.cfg",
]
